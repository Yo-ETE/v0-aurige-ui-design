# AURIGE — exemple de configuration frontend (Next.js)
# Copier vers .env.local : cp .env.example .env.local
#
# En production (nginx reverse-proxy sur le Pi), NE PAS définir ces variables :
# le frontend appelle /api et /ws sur la même origine, nginx proxifie vers le
# backend FastAPI (port 8000). Laisser vide = même origine.

# URL de base de l'API backend (optionnel ; défaut = même origine via nginx).
# Dev / accès direct au backend uniquement :
#   NEXT_PUBLIC_API_URL=http://192.168.1.100:8000
# NEXT_PUBLIC_API_URL=

# URL WebSocket (optionnel ; auto-dérivée de NEXT_PUBLIC_API_URL si non définie).
#   NEXT_PUBLIC_WS_URL=ws://192.168.1.100:8000
# NEXT_PUBLIC_WS_URL=

# ---------------------------------------------------------------------------
# Backend (FastAPI) — variables lues côté serveur (gérées par le unit systemd
# aurige-api, pas par ce .env.local). Listées pour référence ; toutes ont un
# défaut. À définir dans l'environnement du service si besoin de surcharger.
#
#   AURIGE_DATA_DIR=/opt/aurige/data      # missions, logs, dbc, known_frames, aurige.db
#   AURIGE_DB_PATH=                        # défaut: $AURIGE_DATA_DIR/aurige.db
#   AURIGE_CORS_ORIGINS=                   # origines CORS autorisées (CSV)
#   AURIGE_AUTO_HOTSPOT=1                   # hotspot WiFi auto si pas d'internet au boot
#   AURIGE_AUTO_HOTSPOT_SSID=AURIGE
#   AURIGE_AUTO_HOTSPOT_DELAY_S=45
#   AURIGE_AUTO_HOTSPOT_BOOT_WINDOW_S=
